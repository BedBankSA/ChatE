# ChatE — production environment TEMPLATE.
# Copy to deploy/.env.production (Docker) or /etc/chate/chate.env (systemd).
# NEVER commit the filled file. It is gitignored via .env.*.
# Every secret below is intentionally EMPTY. Fill values on the server only.
# chmod 600, owner root:chate. systemd EnvironmentFile format: KEY=value, no export.

# ---------------------------------------------------------------------------
# Public (safe in the browser bundle). NEXT_PUBLIC_* are frozen into the client
# bundle at BUILD time: changing them requires a rebuild.
# ---------------------------------------------------------------------------
APP_URL=https://chate.example.com
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFoJLWRjfC1ZYlwB
TURNSTILE_SITE_KEY=0x4AAAAAAFoJLWRjfC1ZYlwB
# Production hostnames only. localhost/127.0.0.1 are rejected when NODE_ENV=production.
TURNSTILE_EXPECTED_HOSTNAMES=chate.example.com

# ---------------------------------------------------------------------------
# Server secrets — EMPTY. Fill from the provider dashboards, never from Git.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
SESSION_SECRET=
TURNSTILE_SECRET_KEY=
OTP_HTTP_AUTHORIZATION=
OTP_PEPPER=

# ---------------------------------------------------------------------------
# Paths and storage. Absolute paths in production; systemd WorkingDirectory is
# /opt/chate so relative paths would resolve there too.
# ---------------------------------------------------------------------------
SQLITE_PATH=/var/lib/chate/chate.sqlite
STORAGE_DIR=/var/lib/chate/storage
DOWNLOAD_URL_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Quotas. One queued model run = one unit on that provider's account.
# Provider accounts are split: openrouter (shared/user) and anthropic
# (shared:anthropic/user:<id>:anthropic). Default comparison = 3 OR + 1 Anthropic.
# ---------------------------------------------------------------------------
USER_QUOTA_UNITS=200
SHARED_QUOTA_UNITS=2000
MAX_USER_CONCURRENCY=2
MAX_GLOBAL_CONCURRENCY=8
# Documented in .env.example/README but NOT read by current code (hardcoded 120s
# timeout, max 2 retries in src/domain/models/dispatch.ts). Keep defaults only.
MODEL_TIMEOUT_MS=180000
MAX_PROVIDER_RETRIES=2

# ---------------------------------------------------------------------------
# Upload limits (bytes). MAX_FILE_BYTES and the five-file / 50 MiB request caps
# are enforced by src/server/files/storage.ts. MAX_ZIP_* and
# DOWNLOAD_URL_TTL_SECONDS are documented but NOT read by the current code
# (no public download route yet).
# ---------------------------------------------------------------------------
MAX_FILE_BYTES=26214400
MAX_ZIP_ENTRIES=200
MAX_ZIP_DEPTH=4
MAX_ZIP_UNCOMPRESSED_BYTES=104857600

# ---------------------------------------------------------------------------
# Anthropic live calls. OFF by default: src/domain/models/haiku.ts requires
# HAIKU_LIVE_CALLS=1 for any paid Haiku request. Keep 0 until the owner signs a
# spend decision (see docs/launch/LAUNCH-READINESS.md B9).
# ---------------------------------------------------------------------------
HAIKU_LIVE_CALLS=0

# ---------------------------------------------------------------------------
# OTP. Production hard-fails unless provider=http AND an https URL is set
# (src/domain/auth/otp.ts createOtpProvider / validateOtpHttpUrl). The send and
# verify routes are implemented and covered by tests including a real local
# HTTP round-trip; a real carrier SMS gateway account/URL is still required to
# deliver codes to users, and the phone gate stays closed until then.
# The gateway receives POST JSON {"to":"+E164","code":"123456"}.
# ---------------------------------------------------------------------------
OTP_PROVIDER=http
OTP_HTTP_URL=https://sms-provider.example.com/send
# OTP_PEPPER and OTP_HTTP_AUTHORIZATION are defined once, in the secrets block above.

# ---------------------------------------------------------------------------
# Admin allowlist: stable Google "sub" values (preferred), verified emails as
# fallback. Never an email typed into a URL.
# ---------------------------------------------------------------------------
ADMIN_GOOGLE_SUBS=REPLACE_WITH_ADMIN_GOOGLE_SUB
ADMIN_EMAILS=owner@example.com

# ---------------------------------------------------------------------------
# Retention defaults (days). Stored in retention_settings; NO enforcement job
# exists in this build. These values are currently inert.
# ---------------------------------------------------------------------------
RETENTION_COMPARISON_DAYS=90
RETENTION_FILE_DAYS=30
