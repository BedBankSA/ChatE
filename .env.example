# Server-only. The browser must never receive this value.
# Put the real key in .env.local (gitignored). Do not commit it.
ANTHROPIC_API_KEY=

# Server-only. The browser must never receive this value.
OPENROUTER_API_KEY=

# Public site origin. Used for redirects and hostname checks. Not a secret.
# Local ChatE uses port 3211. Port 3000 is a different application on this machine.
# The Google client authorized JavaScript origin must include this exact origin.
APP_URL=http://localhost:3211

# Public Google client id. The GIS ID-token flow does not use a client secret.
# The same public value is exposed to the browser as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server-only session signing secret. Generate a long random value.
SESSION_SECRET=

# Turnstile. The site key is public. The secret stays empty here and on the server only.
# Public widget already issued for this product:
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFoJLWRjfC1ZYlwB
TURNSTILE_SITE_KEY=0x4AAAAAAFoJLWRjfC1ZYlwB
TURNSTILE_SECRET_KEY=
# Comma-separated hostnames. Local dev may use localhost. Production must not include localhost.
TURNSTILE_EXPECTED_HOSTNAMES=localhost,127.0.0.1

# SQLite file. A relative path is resolved from the project root. The file is gitignored.
# Not a secret. Do not put a database URL or password here.
SQLITE_PATH=data/chate.sqlite

# Private file storage. Paths stay on disk; the browser never receives a permanent public URL.
STORAGE_DIR=storage
DOWNLOAD_URL_TTL_SECONDS=300

# Quotas. One comparison to N models reserves N OpenRouter units.
# Haiku is accounted separately and is not drawn from the free-unit pool.
USER_QUOTA_UNITS=200
SHARED_QUOTA_UNITS=2000
MAX_USER_CONCURRENCY=2
MAX_GLOBAL_CONCURRENCY=8
MODEL_TIMEOUT_MS=180000
MAX_PROVIDER_RETRIES=2

# Upload limits shown to the user. Bytes.
MAX_FILE_BYTES=26214400
MAX_ZIP_ENTRIES=200
MAX_ZIP_DEPTH=4
MAX_ZIP_UNCOMPRESSED_BYTES=104857600

# OTP. Production accepts only provider=http and fails closed otherwise.
# fake is for tests and local development and is rejected when NODE_ENV=production.
OTP_PROVIDER=fake
OTP_HTTP_URL=
OTP_HTTP_AUTHORIZATION=
OTP_PEPPER=

# Admin allowlist. Google sub is the stable id. Email is the verified Google email only.
ADMIN_GOOGLE_SUBS=
ADMIN_EMAILS=

# Retention defaults in days. Admins can change the stored values.
RETENTION_COMPARISON_DAYS=90
RETENTION_FILE_DAYS=30

# Background jobs are rows in the SQLite jobs table. Run `npm run worker` in a second terminal.
# That process does not call model providers.
